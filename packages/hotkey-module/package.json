{
	"name": "@svelte-ascend/hotkey-module",
	"version": "0.1.0-alpha.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
