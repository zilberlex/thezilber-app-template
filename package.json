{
	"name": "thezilber-app-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"build:docs": "BASE_PATH='/thezilber-app-template' pnpm build && pnpm sync-docs && git add -f docs",
		"preview": "vite preview",
		"preview:host": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"sync-docs": "shx rm -rf docs && shx mkdir -p docs && shx cp -r build/* docs && shx touch docs/.nojekyll"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.6.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^16.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"shx": "^0.4.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild"
		],
		"overrides": {
			"cookie@<0.7.0": ">=0.7.0"
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource/audiowide": "^5.2.7",
		"devalue": "^5.8.1",
		"dexie": "^4.4.2",
		"runed": "^0.37.1",
		"sass": "^1.99.0",
		"svelte-toolbelt": "^0.10.6"
	}
}
